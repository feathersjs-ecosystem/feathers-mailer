{
  "name": "feathers-mailer",
  "version": "5.0.0",
  "description": "Feathers mailer service",
  "homepage": "https://github.com/feathersjs-ecosystem/feathers-mailer",
  "repository": {
    "type": "git",
    "url": "git://github.com/feathersjs-ecosystem/feathers-mailer.git"
  },
  "bugs": {
    "url": "https://github.com/feathersjs-ecosystem/feathers-mailer/issues"
  },
  "author": {
    "name": "Feathers contributors",
    "email": "hello@feathersjs.com",
    "url": "https://feathersjs.com"
  },
  "contributors": [],
  "license": "MIT",
  "keywords": [
    "feathers",
    "feathers-plugin",
    "mail",
    "email",
    "mailer",
    "nodemailer"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "src/**",
    "dist/**"
  ],
  "engines": {
    "node": ">= 22.18.0"
  },
  "packageManager": "pnpm@11.24.0",
  "prettier": "@feathers-community/eslint-config/prettier",
  "scripts": {
    "build": "tsdown",
    "version": "pnpm run build",
    "release": "np",
    "vitest": "vitest",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "attw": "attw --pack . --profile esm-only",
    "changelog": "github_changelog_generator -u feathersjs-ecosystem -p feathers-mailer && git add CHANGELOG.md && git commit -am \"Updating changelog\""
  },
  "peerDependencies": {
    "nodemailer": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "nodemailer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@feathers-community/eslint-config": "^0.2.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "nodemailer": "^10.0.10",
    "np": "^12.1.1",
    "prettier": "^3.9.8",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
